{
  "name": "gulp-lightning-talk",
  "version": "0.1.0",
  "description": "Slides for a lightning talk built on a customized Reveal.js fork.",
  "homepage": "https://github.com/zkm/gulp-lightning-talk",
  "subdomain": "gulp-lightning-talk",
  "main": "dist/reveal.js",
  "module": "dist/reveal.esm.js",
  "license": "MIT",
  "scripts": {
    "test": "gulp test",
    "start": "gulp serve",
    "build": "gulp build"
  },
  "author": {
    "name": "Zach  Schneider",
    "email": "me@zachschneider.com",
    "url": "https://zkm.tw/"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:zkm/gulp-lightning-talk.git"
  },
  "bugs": {
    "url": "https://github.com/zkm/gulp-lightning-talk/issues"
  },
  "private": true,
  "engines": {
    "node": ">=10.0.0"
  },
  "keywords": [
    "reveal",
    "slides",
    "presentation"
  ],
  "resolutions": {
    "send": "^0.19.0",
    "tmp": "^0.2.6",
    "tar-fs": "^3.1.1",
    "tar": "^7.5.7",
    "brace-expansion": "^1.1.16",
    "lodash": "^4.17.23",
    "qs": "^6.14.2",
    "basic-ftp": "^5.2.0",
    "minimatch@^3.0.4": "^3.1.3",
    "minimatch@^3.1.1": "^3.1.3",
    "minimatch@^10.1.1": "^10.2.3",
    "serialize-javascript": "^7.0.3",
    "flatted": "^3.4.2",
    "picomatch@^4.0.2": "^4.0.4",
    "picomatch@^4.0.3": "^4.0.4",
    "immutable": "^5.1.5",
    "picomatch@^2.0.4": "^2.3.2",
    "picomatch@^2.2.1": "^2.3.2",
    "picomatch@^2.3.1": "^2.3.2",
    "ip-address": "^10.1.1",
    "ws": "^8.21.0",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "js-yaml@^3.13.1": "^3.15.1",
    "js-yaml@^4.1.0": "^4.2.0",
    "websocket-driver": "^0.7.5",
    "postcss": "^8.5.12",
    "node-qunit-puppeteer/puppeteer": "^25.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "babel-plugin-transform-html-import-to-string": "^2.0.0",
    "colors": "^1.4.0",
    "core-js": "^3.47.0",
    "fitty": "^2.4.2",
    "glob": "^13.0.0",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^10.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-connect": "^5.7.0",
    "gulp-eslint": "^6.0.0",
    "gulp-tap": "^2.0.0",
    "gulp-zip": "^6.1.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "node-qunit-puppeteer": "^2.2.1",
    "puppeteer": "^25.9.0",
    "qunit": "^2.24.3",
    "rollup": "^4.59.0",
    "sass": "^1.97.0",
    "yargs": "^18.0.0"
  },
  "browserslist": "> 2%, not dead",
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true
    },
    "parser": "@babel/eslint-parser",
    "parserOptions": {
      "sourceType": "module",
      "allowImportExportEverywhere": true,
      "requireConfigFile": false
    },
    "globals": {
      "module": false,
      "console": false,
      "unescape": false,
      "define": false,
      "exports": false
    },
    "rules": {
      "curly": 0,
      "eqeqeq": 2,
      "wrap-iife": [
        2,
        "any"
      ],
      "no-use-before-define": [
        2,
        {
          "functions": false
        }
      ],
      "new-cap": 2,
      "no-caller": 2,
      "dot-notation": 0,
      "no-eq-null": 2,
      "no-unused-expressions": 0
    }
  },
  "dependencies": {
    "gulp-cli": "^3.1.0"
  },
  "packageManager": "yarn@4.12.0"
}
